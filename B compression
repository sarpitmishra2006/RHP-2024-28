#include<bits/stdc++.h>
#define ll long long
#define endl '\n'
using namespace std;
int main()
{
  ll n;
  cin>>n;
  vector<ll>a(n);
  for(ll i=0;i<n;i++)
    cin>>a[i];
  sort(a.begin(),a.end());
  set<ll>st;
  for(ll i=0;i<n;i++)
  {
    st.insert(a[i]);
  }
  ll k=st.size();
  cout<<k<<endl;
  for( auto x : st)
  {
    cout<<x<< " ";
  }
  return 0;
}
