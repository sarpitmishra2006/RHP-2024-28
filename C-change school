#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main(){
  int n,k,m=0,c=0;
  cin>>n>>k;
  vector<int> v(k+1,0);
  for(int i=1;i<=n;i++){
    int x;
    cin>>x;
    v[x]++;
    m=max(m,v[x]);
  }
  for(int i=1;i<=k;i++){
    if(v[i]>=m-1)c++;
  }
  cout<<c<<endl;
}
