#include <iostream>
#include <vector>
#include <queue>
using namespace std;

int main(){
  int h,w,k;
  cin>>h>>w>>k;
  vector<string> s(h);
  vector<int> row(h,0),col(w,0),d(h*w,-1);
  queue<int> q;
  for(int i=0;i<h;i++){
    cin>>s[i];
    for(int j=0;j<w;j++){
      if(s[i][j]=='#')row[i]=col[j]=1;
    }
  }
  for(int i=0;i<h;i++){
    for(int j=0;j<w;j++){
      if(s[i][j]=='.' && !row[i] && !col[j]){
        d[i*w+j]=0;
        q.push(i*w+j);
      }
    }
  }
  int res=0;
  while(!q.empty()){
    int a=q.front();
    q.pop();
    int r=a/w,c=a%w;
    if(d[a]<=k)res++;
    int diff[5]={-1,0,1,0,-1};
    for(int i=0;i<4;i++){
      int ar=r+diff[i],ac=c+diff[i+1];
      int rc=ar*w+ac;
      if(ar>=0 && ar<h && ac>=0 && ac<w && s[ar][ac]=='.' && d[rc]==-1){
        d[rc]=d[a]+1;
        q.push(rc);
      }
    }
  }
  cout<<res<<endl;
}
