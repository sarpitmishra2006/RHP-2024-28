#include<bits/stdc++.h>
using namespace std;
int n,m,vis[200005],ans=(1<<30)-1;
vector<int> g[200005],w[200005];
void dfs(int x,int s)
{
	vis[x]=1;
	for (int i=0;i<g[x].size();i++)
		if(!vis[g[x][i]]&&(w[x][i]|s)==s)
			dfs(g[x][i],s);
}
int main()
{
	cin>>n>>m;
	for (int i=1,x,y,z;i<=m;i++)
		cin>>x>>y>>z,g[x].push_back(y),g[y].push_back(x),w[x].push_back(z),w[y].push_back(z);
	for (int i=29;i>=0;i--)
	{
		memset(vis,0,sizeof(vis));
		dfs(1,ans-(1<<i));
		ans-=vis[n]*(1<<i);
	}
	cout<<ans<<endl;
	return 0;
}
